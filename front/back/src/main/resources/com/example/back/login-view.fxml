<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="240.0" prefWidth="320.0"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.example.back.LoginController">
    <children>
        <Label layoutX="20.0" layoutY="20.0" text="Chave inicial:" />
        <TextField fx:id="txtKey" layoutX="115.0" layoutY="16.0" />
        <Label layoutX="20.0" layoutY="74.0" text="E-mail:" />
        <TextField fx:id="txtEmail" layoutX="115.0" layoutY="70.0" />
        <Label layoutX="20.0" layoutY="114.0" text="Senha:" />
        <PasswordField fx:id="txtSenha" layoutX="115.0" layoutY="110.0" />
        <Label layoutX="20.0" layoutY="152.0"
               text="Primeiro acesso: somente chave inicial." />
        <Button layoutX="124.0" layoutY="190.0" text="Entrar"
                onAction="#onLoginButtonClick" />
    </children>
</AnchorPane>
